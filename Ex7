#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <signal.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <sys/types.h>

#define PORT 8080
#define BUFFER_SIZE 1024

int server_socket;

/* Function to stop the server */
void stop_server(int signal_number)
{
    printf("\n\nServer stopped.\n");

    close(server_socket);

    exit(0);
}

int main()
{
    int client_socket;
    int process_id;

    struct sockaddr_in server_address;
    struct sockaddr_in client_address;

    socklen_t client_length;

    char buffer[BUFFER_SIZE];

    /* Handle Ctrl + Z */
    signal(SIGTSTP, stop_server);

    /* Handle Ctrl + C also */
    signal(SIGINT, stop_server);

    /* Create socket */
    server_socket = socket(AF_INET, SOCK_STREAM, 0);

    if (server_socket < 0)
    {
        printf("Socket creation failed\n");
        return 1;
    }

    /* Allow reuse of port */
    int option = 1;

    setsockopt(server_socket,
               SOL_SOCKET,
               SO_REUSEADDR,
               &option,
               sizeof(option));

    /* Server address */
    server_address.sin_family = AF_INET;

    server_address.sin_addr.s_addr = INADDR_ANY;

    server_address.sin_port = htons(PORT);

    /* Bind */
    if (bind(server_socket,
             (struct sockaddr *)&server_address,
             sizeof(server_address)) < 0)
    {
        printf("Bind failed\n");

        close(server_socket);

        return 1;
    }

    /* Listen */
    if (listen(server_socket, 10) < 0)
    {
        printf("Listen failed\n");

        close(server_socket);

        return 1;
    }

    printf("====================================\n");
    printf("       CONCURRENT TCP CHAT SERVER\n");
    printf("====================================\n");

    printf("Server started...\n");
    printf("Port number : %d\n", PORT);
    printf("Waiting for clients...\n");

    printf("\nPress Ctrl + Z to stop the server.\n\n");

    while (1)
    {
        client_length = sizeof(client_address);

        /* Accept client */
        client_socket = accept(
            server_socket,
            (struct sockaddr *)&client_address,
            &client_length
        );

        if (client_socket < 0)
        {
            printf("Accept failed\n");
            continue;
        }

        printf("\nClient connected!\n");

        printf("Client IP : %s\n",
               inet_ntoa(client_address.sin_addr));

        /* Create child process */
        process_id = fork();

        if (process_id < 0)
        {
            printf("Fork failed\n");

            close(client_socket);

            continue;
        }

        /* Child process */
        if (process_id == 0)
        {
            /* Child does not need server socket */
            close(server_socket);

            while (1)
            {
                memset(buffer, 0, BUFFER_SIZE);

                /* Receive message from client */
                int received = recv(
                    client_socket,
                    buffer,
                    BUFFER_SIZE - 1,
                    0
                );

                if (received <= 0)
                {
                    printf("\nClient disconnected.\n");
                    break;
                }

                buffer[received] = '\0';

                printf("\nClient: %s", buffer);

                /* Check exit */
                if (strcmp(buffer, "exit\n") == 0 ||
                    strcmp(buffer, "exit") == 0)
                {
                    printf("Client ended the chat.\n");
                    break;
                }

                /* Server message */
                printf("Server: ");

                if (fgets(buffer, BUFFER_SIZE, stdin) == NULL)
                {
                    break;
                }

                /* Send server message */
                send(
                    client_socket,
                    buffer,
                    strlen(buffer),
                    0
                );

                /* Check exit */
                if (strcmp(buffer, "exit\n") == 0 ||
                    strcmp(buffer, "exit") == 0)
                {
                    printf("Chat ended.\n");
                    break;
                }
            }

            close(client_socket);

            exit(0);
        }

        /* Parent process */
        else
        {
            /* Parent does not need client socket */
            close(client_socket);

            printf("Client handled by child process.\n");
        }
    }

    close(server_socket);

    return 0;
}

