#define PORT 8080

struct ARP
{
    char ip[20];
    char mac[20];
};

int main()
{
    int server, client;
    struct sockaddr_in server_addr, client_addr;
    socklen_t len;

    struct ARP table[5];

    char search_ip[20];
    char reply[50];

    int i;
    int found = 0;

    /* ---------------- ARP TABLE ---------------- */

